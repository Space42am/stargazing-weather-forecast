# Runtime secrets belong only in an untracked .env or secret store.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
# Optional legacy Socket Mode listener (not started by the API container).
SLACK_APP_TOKEN=
# Optional existing image host; pipeline retains its text/image fallback.
IMGBB_API_KEY=
# Shared with Marvin as SPACE42_WEATHER_API_TOKEN through Secret Manager.
WEATHER_API_TOKEN=
# Public DNS name with a valid HTTPS certificate.
WEATHER_HOSTNAME=
WEATHER_DB_PATH=data/monitors.sqlite
WEATHER_TIMEZONE=Asia/Yerevan
WEATHER_SHEET_ENABLED=true
WEATHER_SHEET_HOUR=9
# Omit these to retain the current Sheet and tab.
WEATHER_SPREADSHEET_ID=1YtLyXxU3nPAdL5LDcTimX3uMh0AxC0IXsdNSTVB4Gig
WEATHER_SHEET_GID=2107805094
